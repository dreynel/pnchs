# ==============================================================================
# PNCHS Cloud Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NOTE: .env is git-ignored and should NEVER be committed to source control.
# ==============================================================================

# Brevo (Sendinblue) API & SMTP Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_brevo_smtp_login_here
BREVO_SMTP_KEY=your_brevo_smtp_key_here

# Sender Profile
SENDER_NAME=Pototan National Comprehensive High School (PNCHS)
SENDER_EMAIL=your_verified_sender_email@example.com

# Optional Generic SMTP Settings (Overrides Brevo if provided)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_smtp_password
